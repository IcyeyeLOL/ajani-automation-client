{
  "name": "ajani-automation",
  "version": "0.1.0",
  "description": "Voice-first intake and delivery platform for done-for-you business automation systems.",
  "private": true,
  "homepage": "https://ajaniflow.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IcyeyeLOL/ajani-automation-client.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "check:database-contract": "node scripts/audit-database-readonly.mjs --check",
    "test:e2e": "playwright test",
    "test:regression": "playwright test --config audit/playwright.config.ts",
    "test:database": "node scripts/test-local-database.mjs",
    "test:ci": "npm run lint && npm run type-check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@clerk/nextjs": "7.7.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "ai": "^7.0.79",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "8.23.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
