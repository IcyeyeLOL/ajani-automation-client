# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only authentication and data access
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
REQUEST_RATE_LIMIT_SECRET=

# Internal admin access
AJANI_ADMIN_ACCESS_KEY=
AJANI_ADMIN_SESSION_SECRET=
AJANI_ADMIN_ALLOW_ANY_CLERK_USER_IN_DEVELOPMENT=false
# next dev only: open the control desk with the access key alone (no Clerk sign-in). Ignored in production builds.
AJANI_ADMIN_SKIP_SIGN_IN_IN_DEVELOPMENT=false
AJANI_ADMIN_USER_ID_ALLOWLIST=
AJANI_ADMIN_EMAIL_ALLOWLIST=

# Intake processing and notifications
AI_GATEWAY_API_KEY=
# Use fallback to prepare editable intake questions and routes without an AI provider.
AI_PRIMARY_PROVIDER=gateway
REQUEST_DEMAND_MODEL=anthropic/claude-sonnet-5
REQUEST_DEMAND_ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
AUTOMATION_WORKFLOW_MODEL=anthropic/claude-sonnet-5
AUTOMATION_WORKFLOW_ANTHROPIC_MODEL=claude-sonnet-5
DEEPGRAM_API_KEY=
RESEND_API_KEY=
RESEND_FROM=Ajani Automation <requests@ajaniautomation.com>
INTERNAL_NOTIFICATION_TO=

# Analytics connectors (server-only; read by the nightly sync and the control desk)
DRIPIFY_API_KEY=
# YouTube: an API key plus channel gives public numbers; the OAuth trio adds YouTube Analytics.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Instagram professional account token (Instagram API with Instagram Login).
INSTAGRAM_ACCESS_TOKEN=
# 32 random bytes (64 hex characters) that seal renewed tokens in the database: openssl rand -hex 32
CONNECTOR_ENCRYPTION_KEY=
# Turns on POST /api/metrics/ingest for your own automations; at least 32 random characters.
AJANI_METRICS_INGEST_KEY=

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
